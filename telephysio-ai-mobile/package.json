    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~55.0.18",
    "expo-av": "^16.0.8",
    "expo-camera": "~55.0.16",
    "expo-file-system": "~19.0.22",
    "expo-font": "~55.0.6",
    "expo-gl": "~55.0.13",
    "expo-localization": "~55.0.13",
